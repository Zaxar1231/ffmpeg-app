  "pTrack": "Track",
  "pTrackHint": "Which audio track to extract",
  "pExtractFormat": "Format",
  "pExtractFormatHint": "Re-encode to the chosen format",
  "pExtractFormatHelp": "\"As is\" copies the audio unchanged: instant and lossless, the file type matches the codec. Choose MP3/AAC/Opus for a specific player format, FLAC/WAV for lossless editing.",
  "extractAsIs": "As is (no re-encode)",

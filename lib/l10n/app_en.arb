  "pLoudTarget": "Target loudness",
  "pLoudTargetHint": "{lufs} LUFS, peaks at most {tp} dBTP",
  "pLoudTargetHelp": "LUFS is perceived loudness. Platforms turn down anything too loud, so it is best to hit their target: YouTube and Spotify −14, podcasts (Apple) −16, TV per EBU R128 −23. True Peak limits peaks so MP3/AAC compression does not distort.",
  "loudStreaming": "YouTube, Spotify",
  "loudPodcast": "Podcast",
  "loudBroadcast": "TV (EBU R128)",
  "loudApple": "Apple Music",
  "pTwoPassLoud": "Two-pass normalization",
  "pTwoPassLoudOn": "Measure first, then adjust precisely",
  "pTwoPassLoudOff": "One pass: faster, but adjusts dynamically",
  "pTwoPassLoudHelp": "The first pass measures the whole file, the second applies one gain everywhere: dynamics are preserved and the result hits the target. One-pass mode adjusts on the fly and may pump. Default: two-pass.",
  "normalizeNote": "Audio will be re-encoded ({codec}), video copied",
  "pAnimFormat": "Format",
  "pAnimFormatHint": "GIF works everywhere; WebP and APNG look better and are smaller",
  "pAnimFormatHelp": "GIF is limited to 256 colors, so an optimal palette is built for the clip. WebP gives full-color animation 2–5× smaller. APNG is lossless but heavy. Default: GIF.",
